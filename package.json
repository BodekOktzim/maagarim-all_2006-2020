{
  "name": "synthetic-data-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Unified search, entity resolution and relationship graph engine over synthetic data only.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/api & npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "migrate": "npm run migrate --workspace packages/database",
    "seed": "tsx scripts/generate-data.ts --people 100000 --families 20000 --sources 5 --target-size 500MB && tsx scripts/import-data.ts --demo",
    "generate-data": "tsx scripts/generate-data.ts",
    "import-data": "tsx scripts/import-data.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test": "tsx --test $(find packages apps -name '*.test.ts' -o -name '*.test.tsx')",
    "typecheck": "tsc -p tsconfig.check.json --pretty"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
